# Dockerfile.scraper
# Multi-stage image: build with Temurin JDK, runtime on Playwright image (browsers included)

# Stage 1: build the fat JAR using the project's Gradle wrapper
FROM eclipse-temurin:21-jdk-jammy AS builder
WORKDIR /app

# Copy Gradle wrapper and project files
COPY gradlew gradlew.bat gradle.properties settings.gradle.kts build.gradle.kts ./
COPY gradle/ ./gradle/
COPY src/ ./src/

RUN chmod +x ./gradlew
RUN ./gradlew build -x test --no-daemon

# Stage 2: runtime based on Playwright image (browsers & deps preinstalled)
FROM mcr.microsoft.com/playwright:latest
WORKDIR /app

# Install minimal tooling required for runtime operations
RUN apt-get update && apt-get install -y curl ca-certificates --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Install Temurin JRE 21 so the Kotlin/Java jar can run in this image
ENV TEMURIN_URL="https://github.com/adoptium/temurin21-binaries/releases/latest/download/OpenJDK21U-jre_x64_linux_hotspot.tar.gz"
RUN curl -fsSL -o /tmp/temurin.tar.gz "$TEMURIN_URL" \
    && mkdir -p /opt/java \
    && tar -xzf /tmp/temurin.tar.gz -C /opt/java --strip-components=1 \
    && ln -s /opt/java/bin/java /usr/local/bin/java \
    && rm /tmp/temurin.tar.gz

# Copy built jar from builder
COPY --from=builder /app/build/libs/*.jar /app/app.jar

# Default environment variables (override on Render)
ENV GEMINI_API_KEY="" \
    TMDB_API_KEY="" \
    DB_HOST="" \
    DB_PORT="6543" \
    DB_NAME="postgres" \
    DB_USER="postgres" \
    DB_PASSWORD=""

# The worker runs the same jar; Application.kt will start scraping unless SKIP_SCRAPING=true
# For the scraper worker we ensure scraping runs by default, so do NOT set SKIP_SCRAPING here.

CMD ["java", "-jar", "/app/app.jar"]

