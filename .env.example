# Primer .env datoteke
# Kopira ovu datoteku u .env i popuni sa tvojim vrijednostima
# NIKAD ne komituj .env datoteku sa tajnama, samo .env.example!

# Google Gemini API ključ
GEMINI_API_KEY=

# TMDB API ključ
TMDB_API_KEY=

# PostgreSQL / Supabase konekcija
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
# require za Supabase, disable za lokalni Postgres iz docker-compose.yml
DB_SSLMODE=require

# Potpisivanje backend JWT sesije (obavezno)
APP_JWT_SIGNING_KEY=

# Firebase Admin service account (JSON u jednom redu)
FIREBASE_SERVICE_ACCOUNT_JSON=

# false na web servisu - dnevni scraping radi GitHub Actions
SCRAPING_BOOLEAN=false

# Opciono: javna adresa servera, za pune URL-ove avatara u odgovorima
PUBLIC_BASE_URL=

# Server port
PORT=8080

