# Primer .env datoteke
# Kopira ovu datoteku u .env i popuni sa tvojim vrijednostima
# NIKAD ne komituj .env datoteku sa tajnama, samo .env.example!

# Google Gemini API ključ
GEMINI_API_KEY=

# TMDB API ključ
TMDB_API_KEY=

# PostgreSQL / Supabase konekcija
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Server port
PORT=8080

